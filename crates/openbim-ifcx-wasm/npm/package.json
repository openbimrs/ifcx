{
  "name": "@openbim/ifcx",
  "description": "Read, write, validate and compose IFC5 / IFCX files, and export GLB, from JavaScript in Node and the browser (WebAssembly build of openbim-ifcx).",
  "version": "0.2.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbimrs/ifcx.git",
    "directory": "crates/openbim-ifcx-wasm"
  },
  "type": "commonjs",
  "main": "openbim_ifcx_wasm.js",
  "types": "openbim_ifcx_wasm.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./openbim_ifcx_wasm.d.ts",
        "default": "./openbim_ifcx_wasm.js"
      },
      "default": {
        "types": "./bundler/openbim_ifcx_wasm.d.ts",
        "default": "./bundler/openbim_ifcx_wasm.js"
      }
    },
    "./bundler": {
      "types": "./bundler/openbim_ifcx_wasm.d.ts",
      "default": "./bundler/openbim_ifcx_wasm.js"
    },
    "./web": {
      "types": "./web/openbim_ifcx_wasm.d.ts",
      "default": "./web/openbim_ifcx_wasm.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "openbim_ifcx_wasm.js",
    "openbim_ifcx_wasm.d.ts",
    "openbim_ifcx_wasm_bg.wasm",
    "openbim_ifcx_wasm_bg.wasm.d.ts",
    "fetch-imports.js",
    "fetch-imports.d.ts",
    "bundler/",
    "web/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": ["ifcx", "ifc5", "ifc", "bim", "openbim", "gltf", "wasm", "browser"]
}
